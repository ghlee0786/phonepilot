# PhonePilot secrets (PRD 12.2). 이 파일을 복사한 .env 는 저장소 밖(%APPDATA%\PhonePilot\.env)에 둔다.
# 값은 AI에게 전달되지 않는다. AI는 키 이름만 안다.
GOOGLE_MAIN_EMAIL=__set_me__
GOOGLE_MAIN_PASSWORD=__set_me__
GOOGLE_MAIN_DESIRED_USERNAMES=__set_me__
GOOGLE_MAIN_RECOVERY_EMAIL=
PROFILE_MAIN_FIRST_NAME=__set_me__
PROFILE_MAIN_LAST_NAME=__set_me__
PROFILE_MAIN_BIRTH_DATE=1990-01-01
PROFILE_MAIN_GENDER=prefer_not_to_say
YOUTUBE_API_KEY=
UPBIT_MAIN_ACCESS_KEY=
UPBIT_MAIN_SECRET_KEY=
KIS_MAIN_APP_KEY=
KIS_MAIN_APP_SECRET=
KIS_MAIN_ACCOUNT_NO=
ANTHROPIC_API_KEY=
